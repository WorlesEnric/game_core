<Project Sdk="Microsoft.NET.Sdk">

  <!-- GC-026's benchmark suites: the fixture generator at the declared 1,000/10,000 scale, the real derivation engine
       driven over that fixture (base, the three declared update sizes, the 100-target reparent, the 1,000-target
       spawn and the whole-world mode switch), nearest-rank statistics, the sample/allocation/memory record, the JSON
       and CSV writers and the provisional budget rows. The sources live in `tests/GameCore.Benchmarks/Tests` so the
       same files also run as Unity EditMode tests (the package is testable).

       The fixture derivations run over a real 10,000-target world, so this suite takes seconds rather than
       milliseconds; nothing here measures a wall clock, so it stays deterministic on a loaded build host. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>GameCore.Benchmarks.Tests</AssemblyName>
    <RootNamespace>GameCore.Benchmarks.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);GAMECORE_TELEMETRY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../tests/GameCore.Benchmarks/Tests/**/*.cs"
             Exclude="../../../tests/GameCore.Benchmarks/Tests/**/bin/**/*.cs;../../../tests/GameCore.Benchmarks/Tests/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/GameCore.Benchmarks/GameCore.Benchmarks.csproj" />
    <ProjectReference Include="../../src/GameCore.Contracts/GameCore.Contracts.csproj" />
    <ProjectReference Include="../../src/GameCore.Derivation/GameCore.Derivation.csproj" />
    <ProjectReference Include="../../src/GameCore.Derivation.Fixtures/GameCore.Derivation.Fixtures.csproj" />
  </ItemGroup>

</Project>
