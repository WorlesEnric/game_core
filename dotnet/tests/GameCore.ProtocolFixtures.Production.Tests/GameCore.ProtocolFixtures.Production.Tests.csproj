<Project Sdk="Microsoft.NET.Sdk">

  <!-- Production-contract fixture run (GC-003). Compiles the same test source as
       dotnet/tests/GameCore.ProtocolFixtures.Tests so the identical suite executes against the production
       GameCore.Contracts assembly. The result document name is overridden so this run does not overwrite the
       reference-seam run's evidence. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../GameCore.ProtocolFixtures.Tests/ProtocolFixtureTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/GameCore.ProtocolFixtures.Production/GameCore.ProtocolFixtures.Production.csproj" />
    <ProjectReference Include="../../src/GameCore.Contracts/GameCore.Contracts.csproj" />
  </ItemGroup>

</Project>
