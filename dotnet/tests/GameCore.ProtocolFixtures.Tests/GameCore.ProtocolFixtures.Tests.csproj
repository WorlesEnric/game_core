<Project Sdk="Microsoft.NET.Sdk">

  <!-- Protocol fixture execution tests (GC-002). Loads every committed JSON fixture, asserts the oracle
       distinguishes valid from invalid outcomes, and writes the result document to
       artifacts/protocol-fixtures/results.json. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/GameCore.ProtocolFixtures/GameCore.ProtocolFixtures.csproj" />
    <ProjectReference Include="../../src/GameCore.ReferenceSeams/GameCore.ReferenceSeams.csproj" />
  </ItemGroup>

</Project>
