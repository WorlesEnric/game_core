<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure planning tests; sources live in Packages/com.gamecore.planning/Tests/<Area>/ and also run as Unity EditMode tests. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>GameCore.Planning.Tests</AssemblyName>
    <RootNamespace>GameCore.Planning.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.planning/Tests/**/*.cs"
             Exclude="../../../Packages/com.gamecore.planning/Tests/**/bin/**/*.cs;../../../Packages/com.gamecore.planning/Tests/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/GameCore.Planning/GameCore.Planning.csproj" />
    <ProjectReference Include="../../src/GameCore.Contracts/GameCore.Contracts.csproj" />
  </ItemGroup>

</Project>
