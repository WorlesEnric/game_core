<Project Sdk="Microsoft.NET.Sdk">

  <!-- API snapshot generator (GC-002). Tooling only: reflection over a compiled assembly is allowed here.
       The snapshot test project links this project and regenerates the listing in-process. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>GameCore.ApiSnapshot</AssemblyName>
    <RootNamespace>GameCore.ApiSnapshot</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- No project reference: the tool loads the assembly under test by path (assembly CLI option) or receives it as a
       System.Reflection.Assembly argument, so it needs no compile-time dependency on any contract assembly.
       Referencing the seam here would flow it transitively into every consumer, and because the seam declares
       the same type names in the same namespace as production GameCore.Contracts, that would make every
       contract type ambiguous (CS0433) in the consuming test projects. -->

</Project>
