<Project Sdk="Microsoft.NET.Sdk">

  <!-- GC-024's reference-conformance fixtures: every before/after table of `docs/game-core/07-reference-compositions.md`
       as data, the ordered script each table executes through in a real world, the canonical normalized trace, the
       oracle that compares a trace against its table, and the pure-rule projection of every number those tables
       assert. Sources live in `tests/GameCore.ReferenceConformance/Runtime` and are also compiled by the Unity package
       `com.gamecore.reference-conformance` (assembly GameCore.ReferenceConformance), so the same fixtures run in plain
       dotnet, in Unity EditMode and in the qualification player.

       Unity-free by design (P-001): no UnityEngine/Unity.* type appears in these files. The real-world half of the
       conformance claim is the qualification project's own ConformanceScenario over the same fixtures; this project
       proves the fixture's self-consistency, its agreement with the rules packages, and the kernel's own assembly
       validation of the deliberately broken declaration sets `CrossGraphValidation` builds (GC-024, 07:278). -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.ReferenceConformance</AssemblyName>
    <RootNamespace>GameCore.ReferenceConformance</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../tests/GameCore.ReferenceConformance/Runtime/**/*.cs"
             Exclude="../../../tests/GameCore.ReferenceConformance/Runtime/**/bin/**/*.cs;../../../tests/GameCore.ReferenceConformance/Runtime/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCore.Contracts/GameCore.Contracts.csproj" />
    <!-- GC-024: `CrossGraphValidation` drives the real `GameCore.Planning` validators and compiler, so the combined
         graph's assembly-validation checks run in plain dotnet beside the tables they belong to. -->
    <ProjectReference Include="../GameCore.Planning/GameCore.Planning.csproj" />
    <ProjectReference Include="../GameCore.Rules.Cards/GameCore.Rules.Cards.csproj" />
    <ProjectReference Include="../GameCore.Rules.Narrative/GameCore.Rules.Narrative.csproj" />
    <ProjectReference Include="../GameCore.Rules.Traversal/GameCore.Rules.Traversal.csproj" />
  </ItemGroup>

</Project>
