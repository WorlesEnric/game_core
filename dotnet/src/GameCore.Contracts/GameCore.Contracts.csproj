<Project Sdk="Microsoft.NET.Sdk">

  <!-- Production Unity-free contract assembly (GC-003). The same sources are compiled by Unity through
       Packages/com.gamecore.contracts, so this project only wires a plain SDK build over them. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.Contracts</AssemblyName>
    <RootNamespace>GameCore.Contracts</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- GC-023: the contracts compilation carries the telemetry switch too, because
         `TelemetrySchema.IsCompiledIn` reports the build shape this assembly was compiled in. Every
         instrumented assembly takes the symbol from the same qualification marker package, so the
         answer is the same in all of them; a shipping project omits the marker from all of them. -->
    <DefineConstants>$(DefineConstants);GAMECORE_TELEMETRY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.contracts/Runtime/**/*.cs"
             Exclude="../../../Packages/com.gamecore.contracts/Runtime/**/bin/**/*.cs;../../../Packages/com.gamecore.contracts/Runtime/**/obj/**/*.cs" />
  </ItemGroup>

</Project>
