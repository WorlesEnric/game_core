<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure narrative rules assembly (GC-010): chapter content, durable quest facts, dialogue choice
       validation, gate evaluation, encounter hook plans, the derivation plan and the canonical narrative
       trace. Same sources as Packages/com.gamecore.rules.narrative/Runtime, so the files build under plain
       dotnet and inside Unity. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.Rules.Narrative</AssemblyName>
    <RootNamespace>GameCore.Rules.Narrative</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.rules.narrative/Runtime/**/*.cs"
             Exclude="../../../Packages/com.gamecore.rules.narrative/Runtime/**/bin/**/*.cs;../../../Packages/com.gamecore.rules.narrative/Runtime/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCore.Contracts/GameCore.Contracts.csproj" />
  </ItemGroup>

</Project>
