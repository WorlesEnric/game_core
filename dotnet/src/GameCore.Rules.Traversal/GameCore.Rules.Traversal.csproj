<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure traversal-rules assembly (GC-020): runner/checkpoint identities, the movement vocabulary, the exact
       integer fixed-step kinematics, the checkpoint course rules and the reducer/predicate registration seam. Same
       sources as Packages/com.gamecore.rules.traversal/Runtime, so the files build under plain dotnet and inside
       Unity. No UnityEngine or Unity.* reference is allowed in these files. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.Rules.Traversal</AssemblyName>
    <RootNamespace>GameCore.Rules.Traversal</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.rules.traversal/Runtime/**/*.cs"
             Exclude="../../../Packages/com.gamecore.rules.traversal/Runtime/**/bin/**/*.cs;../../../Packages/com.gamecore.rules.traversal/Runtime/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCore.Contracts/GameCore.Contracts.csproj" />
    <ProjectReference Include="../GameCore.Derivation/GameCore.Derivation.csproj" />
  </ItemGroup>

</Project>
