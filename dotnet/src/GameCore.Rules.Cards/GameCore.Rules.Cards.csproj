<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure card-rules assembly (GC-011): table/seat identities, the command vocabulary, the bounded atomic write
       set, the settlement rules and the reducer/predicate registration seam. Same sources as
       Packages/com.gamecore.rules.cards/Runtime, so the files build under plain dotnet and inside Unity. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.Rules.Cards</AssemblyName>
    <RootNamespace>GameCore.Rules.Cards</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.rules.cards/Runtime/**/*.cs"
             Exclude="../../../Packages/com.gamecore.rules.cards/Runtime/**/bin/**/*.cs;../../../Packages/com.gamecore.rules.cards/Runtime/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCore.Contracts/GameCore.Contracts.csproj" />
  </ItemGroup>

</Project>
