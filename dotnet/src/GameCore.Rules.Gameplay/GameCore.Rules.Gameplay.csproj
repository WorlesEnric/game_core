<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure gameplay-rules assembly (P1.1): entity lifecycle/variant/scale rules, the region residency state machine,
       the region graph and travel validation. Same sources as Packages/com.gamecore.rules.gameplay/Runtime, so the
       files build under plain dotnet and inside Unity. No UnityEngine or Unity.* reference is allowed in these files. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.Rules.Gameplay</AssemblyName>
    <RootNamespace>GameCore.Rules.Gameplay</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.rules.gameplay/Runtime/**/*.cs"
             Exclude="../../../Packages/com.gamecore.rules.gameplay/Runtime/**/bin/**/*.cs;../../../Packages/com.gamecore.rules.gameplay/Runtime/**/obj/**/*.cs" />
  </ItemGroup>

</Project>
