<Project Sdk="Microsoft.NET.Sdk">

  <!-- GameCore Studio model (P0.3, docs/studio/03-authoring-contracts.md, SADR-008): Unity-free authoring identity,
       selection, semantic index, tool catalog + authoring attributes, change sets, diagnostics and validation. Same
       sources as Packages/com.gamecore.studio.core/Runtime/Model, so the files build under plain dotnet and inside
       Unity (where Newtonsoft.Json comes from com.unity.nuget.newtonsoft-json as a precompiled reference). -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.Studio.Model</AssemblyName>
    <RootNamespace>GameCore.Studio.Model</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.studio.core/Runtime/Model/**/*.cs"
             Exclude="../../../Packages/com.gamecore.studio.core/Runtime/Model/**/bin/**/*.cs;../../../Packages/com.gamecore.studio.core/Runtime/Model/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCore.Contracts/GameCore.Contracts.csproj" />
  </ItemGroup>

</Project>
