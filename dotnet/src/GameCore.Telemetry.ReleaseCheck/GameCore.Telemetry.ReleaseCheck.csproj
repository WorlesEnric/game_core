<Project Sdk="Microsoft.NET.Sdk">

  <!-- GC-023's disabled-shape proof, part two (the real instrumented sources).
       ==========================================================================================
       `Packages/com.gamecore.derivation/Runtime/**` is the richest GC-023 instrumentation in the kernel: the strata
       counter, the control-node counter at every index and closure site, and the owner's `WriteTelemetry`. It is
       engine-free on purpose, so it compiles here in both configurations:

         -c Release        -> GAMECORE_TELEMETRY undefined, i.e. what a shipping project sees
         -c Qualification  -> GAMECORE_TELEMETRY defined,  i.e. what the validation project sees

       In Release the assembly must reference the counting helpers *nowhere* (every call site is gone), while in
       Qualification it must reference them. `tools/check_release_telemetry_free.py` builds both and scans both, so a
       new unguarded counting call in the derivation package fails the check on the next run. The second half is what
       stops the check from passing by inspecting an assembly that contains nothing at all.

       Like GC-017's `GameCore.Faults.ReleaseCheck`, this project is deliberately NOT in `dotnet/GameCore.sln`. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.Derivation.ReleaseCheck</AssemblyName>
    <RootNamespace>GameCore.Derivation</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Configurations>Debug;Release;Qualification</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Qualification'">
    <DefineConstants>$(DefineConstants);GAMECORE_TELEMETRY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.derivation/Runtime/**/*.cs"
             Exclude="../../../Packages/com.gamecore.derivation/Runtime/**/bin/**/*.cs;../../../Packages/com.gamecore.derivation/Runtime/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCore.Contracts/GameCore.Contracts.csproj" />
  </ItemGroup>

</Project>
