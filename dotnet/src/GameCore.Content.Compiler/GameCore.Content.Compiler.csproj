<Project Sdk="Microsoft.NET.Sdk">

  <!-- Production content-compiler core (GC-003). Unity-free and Editor-only in Unity; the same sources are
       compiled by Unity through Packages/com.gamecore.content.compiler/Runtime. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.Content.Compiler</AssemblyName>
    <RootNamespace>GameCore.Content.Compiler</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.content.compiler/Runtime/**/*.cs"
             Exclude="../../../Packages/com.gamecore.content.compiler/Runtime/**/bin/**/*.cs;../../../Packages/com.gamecore.content.compiler/Runtime/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCore.Contracts/GameCore.Contracts.csproj" />
  </ItemGroup>

</Project>
