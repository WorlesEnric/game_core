<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure derivation assembly (GC-006): descriptor matching, scope reach, mode grants, strata, output
       slots, the five composition policies, provenance, budgets and the reference oracle. Same sources as
       Packages/com.gamecore.derivation/Runtime, so the files build under plain dotnet and inside Unity. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.Derivation</AssemblyName>
    <RootNamespace>GameCore.Derivation</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.derivation/Runtime/**/*.cs"
             Exclude="../../../Packages/com.gamecore.derivation/Runtime/**/bin/**/*.cs;../../../Packages/com.gamecore.derivation/Runtime/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCore.Contracts/GameCore.Contracts.csproj" />
  </ItemGroup>

</Project>
