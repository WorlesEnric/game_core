<Project Sdk="Microsoft.NET.Sdk">

  <!-- Planning assembly shared by GC-007 (Ownership/), GC-008 (Plans/) and GC-009 (Scheduling/). Same sources as Packages/com.gamecore.planning/Runtime. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.Planning</AssemblyName>
    <RootNamespace>GameCore.Planning</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- GC-023: the plain-dotnet shadow build is the *instrumented diagnostic* build (08 s3 records the
         instrumented build and the release-like measurement build separately). The same symbol reaches
         Unity only through the qualification marker package com.gamecore.telemetry-qualification, so a
         shipping project compiles every counting call site away. -->
    <DefineConstants>$(DefineConstants);GAMECORE_TELEMETRY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.planning/Runtime/**/*.cs"
             Exclude="../../../Packages/com.gamecore.planning/Runtime/**/bin/**/*.cs;../../../Packages/com.gamecore.planning/Runtime/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCore.Contracts/GameCore.Contracts.csproj" />
  </ItemGroup>

</Project>
