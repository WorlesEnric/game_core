<Project Sdk="Microsoft.NET.Sdk">

  <!-- Production composition assembly (GC-004): managed scopes, services, configuration, lifecycle/resource
       ledger and immutable composition snapshots (docs/game-core/01-architecture.md s1, 04 s2). The same
       sources are compiled by Unity through Packages/com.gamecore.composition/Runtime.
       The W1 gate substituted the production GameCore.Contracts project for the W0 test-only reference seam,
       so this project and Packages/com.gamecore.composition now compile against the same contract assembly. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>GameCore.Composition</AssemblyName>
    <RootNamespace>GameCore.Composition</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../Packages/com.gamecore.composition/Runtime/**/*.cs"
             Exclude="../../../Packages/com.gamecore.composition/Runtime/**/bin/**/*.cs;../../../Packages/com.gamecore.composition/Runtime/**/obj/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GameCore.Contracts/GameCore.Contracts.csproj" />
  </ItemGroup>

</Project>
