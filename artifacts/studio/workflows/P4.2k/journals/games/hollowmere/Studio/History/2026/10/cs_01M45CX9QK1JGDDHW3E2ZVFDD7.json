              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "You lit the old shrine. My mother tended it. I owe you a crossing.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Odd_thanks.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
