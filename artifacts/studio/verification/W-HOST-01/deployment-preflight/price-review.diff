--- installed/ops.toml
+++ template/ops.toml
@@ -2,8 +2,8 @@
 # <root>/ops.toml by studio/etos/install.sh (no substitutions). Keys are credential references
 # resolved by etosd from its environment; none is written here.
 #
-# Prices (`[providers.cost]`) are not configured: no verified price list. `max_cost_usd` checks
-# therefore estimate 0 until an operator adds `per_unit`.
+# List prices checked 2026-10-05. Companion caps fail closed if no matching ops_prices
+# entry exists. Image per_unit is an output-only estimate, not a total fixed tariff.
 
 # Voice input: transcript-only realtime sessions (the companion never sends response_create).
 [[realtime]]
@@ -27,6 +27,15 @@
 [providers.limits]
 timeout = "300s"
 max_outputs = 4
+# Source: https://developers.openai.com/api/docs/guides/image-generation
+# GPT Image 2 low 1024x1024: $0.006 output-only estimate per image.
+# Source: https://developers.openai.com/api/docs/models/gpt-image-2
+# Text input $2.50/M; image output $15/M. Input images cost $4/M, so reference edits
+# need a separately priced provider. Echo markup is unverified; see R3 Left open.
+[providers.cost]
+per_unit = 0.006
+per_1m_input_tokens = 2.5
+per_1m_output_tokens = 15.0
 
 # Image description: a vision chat model of models.toml.
 [[providers]]
@@ -34,6 +43,10 @@
 family = "describe"
 kind = "chat"
 model = "echo/gpt-5.6-sol"
+# Source: https://developers.openai.com/api/docs/models/gpt-5.6-sol
+[providers.cost]
+per_1m_input_tokens = 4.0
+per_1m_output_tokens = 20.0
 
 # Text to speech: DashScope native multimodal-generation (etos kind `bailian-tts`, SADR-005).
 [[providers]]
@@ -46,6 +59,10 @@
 options = { voice = "Cherry", language_type = "English" }
 [providers.limits]
 timeout = "120s"
+# Source: https://www.alibabacloud.com/help/en/model-studio/model-pricing
+# Qwen3-TTS-Flash, Chinese mainland: $0.114682 / 10,000 input characters.
+[providers.cost]
+per_unit = 0.0000114682
 
 # 3D generation (family "3d", kind "predictions") is deliberately absent: no provider
 # credential exists on this host (SADR-020). `POST /ops/generate.3d` therefore answers

--- installed/models.toml
+++ template/models.toml
@@ -2,9 +2,9 @@
 # <root>/models.toml by studio/etos/install.sh (no substitutions). The key is resolved by
 # etosd from its environment on every call and is never written here.
 #
-# Prices are deliberately not configured: no provider price list was verified for this host,
-# so usage is reported in tokens and the catalog's cost is 0 (budgets in USD do not bind chat
-# models until an operator adds [models.sla] cost entries).
+# List prices checked 2026-10-05 from the model publishers. Echo's reseller tariff is
+# not publicly verifiable; the integrator must reconcile any markup before deployment.
+# No zero-price model entries. Rates below are USD / million tokens at standard context.
 
 [endpoints.echo]
 base_url = "https://api.echo-coding.com/v1"
@@ -21,6 +21,11 @@
 aliases = ["default"]
 roles = ["worker", "planning", "controller", "compaction"]
 cost_class = "high"
+# Source (all three rates): https://platform.claude.com/docs/en/models/opus-5-5/whats-new-opus-5-5
+[models.sla.cost]
+input = 4.0
+cached_input = 0.2
+output = 20.0
 [models.capabilities]
 context_window = 200000
 max_output = 32000
@@ -34,6 +39,11 @@
