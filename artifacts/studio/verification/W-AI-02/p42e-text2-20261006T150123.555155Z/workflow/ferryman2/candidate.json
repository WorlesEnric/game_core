rgs":{"location":[4.0,0.083,1.1],"name":"Odd the Ferryman"},"dependsOn":[],"preconditions":"stamp","applyRequirement":"Rebuild"},{"opId":"op2","tool":"set","target":{"kind":"Definition","authoringId":"aa779457-076d-496c-84b5-72019a826681","global":"GlobalObjectId_V1-3-b2bacaee2c3034819a57dae4f343b3ee-11400000-0","assetGuid":"b2bacaee2c3034819a57dae4f343b3ee","path":"Assets/Hollowmere/Dialogue/Graphs/Odd.asset","scope":"Definition","stamp":"sha256:7109950a3db1bf17eedade058d30f1818a77701528b168bd5cd0556e0e4d07e1"},"args":{"field":"nodes","value":[{"condition":{"assetGuid":"5dc4b5ce6affc78bc94dd2031bc52e2d","authoringId":"a6f7c2a5-47b1-4fe9-a6fb-a5946f443f67","global":"GlobalObjectId_V1-3-5dc4b5ce6affc78bc94dd2031bc52e2d-11400000-0","kind":"Definition","path":"Assets/Hollowmere/Rules/Conditions/OddFavour.asset"},"kind":"Branch","options":[],"speaker":"","speakerEntityId":"","text":""},{"condition":{"assetGuid":"850520e0be842c7e9830bf255c4a9069","authoringId":"28e34721-a716-4890-a863-fb0cfba9df30","global":"GlobalObjectId_V1-3-850520e0be842c7e9830bf255c4a9069-11400000-0","kind":"Definition","path":"Assets/Hollowmere/Rules/Conditions/ShrineLit.asset"},"kind":"Branch","options":[],"speaker":"","speakerEntityId":"","text":""},{"kind":"Line","options":[],"speaker":"","speakerEntityId":"","text":"The belfry? I ferry no strangers over that water. Light the sunken shrine, west to east, and we will talk. Or patch the old punt yourself; it wants pitch from an oil flask.","voiceClip":{"assetGuid":"5fdc82ba185d091d09bf83838a024617","global":"GlobalObjectId_V1-1-5fdc82ba185d091d09bf83838a024617-8300000-0","kind":"Asset","path":"Assets/Hollowmere/Media/Voices/Odd_refuse.wav"}},{"kind":"Line","options":[],"speaker":"","speakerEntityId":"","text":"You lit the old shrine. My mother tended it. I owe you a crossing.","voiceClip":{"assetGuid":"b4ca9038e0c69834695bc1d46b2921b2","global":"GlobalObjectId_V1-1-b4ca9038e0c69834695bc1d46b2921b2-8300000-0","kind":"Asset","path":"Assets/Hollowmere/Media/Voices/Odd_thanks.wav"}},{"actions":{"assetGuid":"e952c26493555ce73964aef5c959145a","authoringId":"d2a1a116-34a6-4f16-bd03-7575628b11d9","global":"GlobalObjectId_V1-3-e952c26493555ce73964aef5c959145a-11400000-0","kind":"Definition","path":"Assets/Hollowmere/Rules/Actions/OddGrantsFavour.asset"},"kind":"Action","options":[],"speaker":"","speakerEntityId":"","text":""},{"kind":"Choice","options":[{"condition":{"assetGuid":"abc1982dda435320caeb533fec290a89","authoringId":"78eeeedd-9917-460a-8d0e-71d128dc7246","global":"GlobalObjectId_V1-3-abc1982dda435320caeb533fec290a89-11400000-0","kind":"Definition","path":"Assets/Hollowmere/Rules/Conditions/HasLantern.asset"},"hideWhenUnavailable":false,"text":"Take me to the belfry."},{"hideWhenUnavailable":false,"text":"Not yet."}],"speaker":"","speakerEntityId":"","text":"The black water is calm tonight. Hear the belfry bell? Its toll carries across the water, even when no one is in the tower."},{"actions":{"assetGuid":"a352f18a1dcae618b83742479b4bbcc5","authoringId":"421c017e-2867-4d58-821a-67045e416c1b","global":"GlobalObjectId_V1-3-a352f18a1dcae618b83742479b4bbcc5-11400000-0","kind":"Definition","path":"Assets/Hollowmere/Rules/Actions/FerryCrossing.asset"},"kind":"Action","options":[],"speaker":"","speakerEntityId":"","text":""},{"kind":"Line","options":[],"speaker":"","speakerEntityId":"","text":"I will be here. The water is patient.","voiceClip":{"assetGuid":"7650ef440c5863f3f8658e8e77831ae2","global":"GlobalObjectId_V1-1-7650ef440c5863f3f8658e8e77831ae2-8300000-0","kind":"Asset","path":"Assets/Hollowmere/Media/Voices/Odd_wait.wav"}}]},"dependsOn":[],"preconditions":"stamp","applyRequirement":"Live"}],"artifacts":[],"requirements":{"max":"Rebuild","worldRebuild":true,"compile":false,"build":false},"links":{"etosTasks":["tf3a653a2aee9ab5a02c7ea9d"]}}
