/Hollowmere/Rules/Conditions/ShrineLit.asset"}, "actions": null, "options": []}, {"kind": "Line", "speaker": "", "speakerEntityId": "", "text": "The belfry? I ferry no strangers over that water. Light the sunken shrine, west to east, and we will talk. Or patch the old punt yourself; it wants pitch from an oil flask.", "voiceClip": {"kind": "Asset", "global": "GlobalObjectId_V1-1-5fdc82ba185d091d09bf83838a024617-8300000-0", "assetGuid": "5fdc82ba185d091d09bf83838a024617", "path": "Assets/Hollowmere/Media/Voices/Odd_refuse.wav"}, "portrait": null, "condition": null, "actions": null, "options": []}, {"kind": "Line", "speaker": "", "speakerEntityId": "", "text": "You lit the old shrine. My mother tended it. I owe you a crossing.", "voiceClip": {"kind": "Asset", "global": "GlobalObjectId_V1-1-b4ca9038e0c69834695bc1d46b2921b2-8300000-0", "assetGuid": "b4ca9038e0c69834695bc1d46b2921b2", "path": "Assets/Hollowmere/Media/Voices/Odd_thanks.wav"}, "portrait": null, "condition": null, "actions": null, "options": []}, {"kind": "Action", "speaker": "", "speakerEntityId": "", "text": "", "voiceClip": null, "portrait": null, "condition": null, "actions": {"kind": "Definition", "authoringId": "d2a1a116-34a6-4f16-bd03-7575628b11d9", "global": "GlobalObjectId_V1-3-e952c26493555ce73964aef5c959145a-11400000-0", "assetGuid": "e952c26493555ce73964aef5c959145a", "path": "Assets/Hollowmere/Rules/Actions/OddGrantsFavour.asset"}, "options": []}, {"kind": "Choice", "speaker": "", "speakerEntityId": "", "text": "The black water is calm tonight.", "voiceClip": null, "portrait": null, "condition": null, "actions": null, "options": [{"text": "Take me to the belfry.", "condition": {"kind": "Definition", "authoringId": "78eeeedd-9917-460a-8d0e-71d128dc7246", "global": "GlobalObjectId_V1-3-abc1982dda435320caeb533fec290a89-11400000-0", "assetGuid": "abc1982dda435320caeb533fec290a89", "path": "Assets/Hollowmere/Rules/Conditions/HasLantern.asset"}, "hideWhenUnavailable": false}, {"text": "Not yet.", "condition": null, "hideWhenUnavailable": false}]}, {"kind": "Action", "speaker": "", "speakerEntityId": "", "text": "", "voiceClip": null, "portrait": null, "condition": null, "actions": {"kind": "Definition", "authoringId": "421c017e-2867-4d58-821a-67045e416c1b", "global": "GlobalObjectId_V1-3-a352f18a1dcae618b83742479b4bbcc5-11400000-0", "assetGuid": "a352f18a1dcae618b83742479b4bbcc5", "path": "Assets/Hollowmere/Rules/Actions/FerryCrossing.asset"}, "options": []}, {"kind": "Line", "speaker": "", "speakerEntityId": "", "text": "I will be here. The water is patient.", "voiceClip": {"kind": "Asset", "global": "GlobalObjectId_V1-1-7650ef440c5863f3f8658e8e77831ae2-8300000-0", "assetGuid": "7650ef440c5863f3f8658e8e77831ae2", "path": "Assets/Hollowmere/Media/Voices/Odd_wait.wav"}, "portrait": null, "condition": null, "actions": null, "options": []}]}}, "preconditions": "none"}], "after": [{"ref": {"kind": "Definition", "authoringId": "aa779457-076d-496c-84b5-72019a826681", "global": "GlobalObjectId_V1-3-b2bacaee2c3034819a57dae4f343b3ee-11400000-0", "assetGuid": "b2bacaee2c3034819a57dae4f343b3ee", "path": "Assets/Hollowmere/Dialogue/Graphs/Odd.asset"}, "stamp": "sha256:ee446f86b0753a785fe5c93717986a6588548eac92712a9753a0f0377193cfbf"}]}}}], "diagnostics": [], "shot": "keyframes/024-ferryman2-apply.png", "utc": "2026-10-06T15:08:09.626Z", "step": 28, "stepName": "apply ferryman2", "name": "ferryman2-apply", "caption": "Apply (AllOrNothing): Applied in 50.6 ms; outcomes op1=Applied, op2=Applied. History lists the entry."}
