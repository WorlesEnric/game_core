                      {
                        "kind": "Branch",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "",
                        "voiceClip": null,
                        "portrait": null,
                        "condition": {
                          "kind": "Definition",
                          "authoringId": "9fa5e8cb-4aaf-4a16-bbac-05bf75af633a",
                          "global": "GlobalObjectId_V1-3-25070db6c5ef45f9bbc94d6547da39f1-11400000-0",
                          "assetGuid": "25070db6c5ef45f9bbc94d6547da39f1",
                          "path": "Assets/Hollowmere/Rules/Conditions/HeardRumour.asset"
                        },
                        "actions": null,
                        "options": []
                      },
                      {
                        "kind": "Line",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "Traveller, you look half drowned yourself. Sit a moment. I am Maren, the healer here.",
                        "voiceClip": {
                          "kind": "Asset",
                          "global": "GlobalObjectId_V1-1-f897124a7f0c7103ab101d1bc29dfcf5-8300000-0",
                          "assetGuid": "f897124a7f0c7103ab101d1bc29dfcf5",
                          "path": "Assets/Hollowmere/Media/Voices/Maren_greet.wav"
                        },
                        "portrait": null,
                        "condition": null,
                        "actions": null,
                        "options": []
                      },
                      {
                        "kind": "Line",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "Since the flood the bell in the old belfry has been silent, and the marsh has gone dark and hungry.",
                        "voiceClip": {
                          "kind": "Asset",
                          "global": "GlobalObjectId_V1-1-5cac189b9b64139d78bb343d7af7ccdc-8300000-0",
                          "assetGuid": "5cac189b9b64139d78bb343d7af7ccdc",
                          "path": "Assets/Hollowmere/Media/Voices/Maren_rumour.wav"
                        },
                        "portrait": null,
                        "condition": null,
                        "actions": null,
                        "options": []
                      },
                      {
                        "kind": "Action",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "",
                        "voiceClip": null,
                        "portrait": null,
                        "condition": null,
                        "actions": {
                          "kind": "Definition",
                          "authoringId": "266d333d-2e6d-47e6-8e71-8004cf7f4aca",
                          "global": "GlobalObjectId_V1-3-88ad7492e109d8e92b568b9d4ce3a92d-11400000-0",
                          "assetGuid": "88ad7492e109d8e92b568b9d4ce3a92d",
                          "path": "Assets/Hollowmere/Rules/Actions/MarenIntro.asset"
                        },
                        "options": []
                      },
                      {
                        "kind": "Choice",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "Will you go to the belfry?",
                        "voiceClip": null,
                        "portrait": null,
                        "condition": null,
                        "actions": null,
                        "options": [
                          {
                            "text": "How do I cross the marsh?",
                            "condition": null,
                            "hideWhenUnavailable": false
                          },
                          {
                            "text": "Where would I find a lantern?",
                            "condition": null,
                            "hideWhenUnavailable": false
                          },
                          {
                            "text": "I will go.",
                            "condition": null,
                            "hideWhenUnavailable": false
                          }
                        ]
                      },
                      {
                        "kind": "Line",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "Warden Hale keeps the causeway gate and lets no one into Blackmere without a light. Past it, Odd's ferry, or the old punt by the jetty.",
                        "voiceClip": {
                          "kind": "Asset",
                          "global": "GlobalObjectId_V1-1-926ffe37e1bd19903a03bddf3bc329d3-8300000-0",
                          "assetGuid": "926ffe37e1bd19903a03bddf3bc329d3",
                          "path": "Assets/Hollowmere/Media/Voices/Maren_cross.wav"
                        },
                        "portrait": null,
                        "condition": null,
                        "actions": null,
                        "options": []
                      },
                      {
                        "kind": "Line",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "Bram sells them at the inn. There was one in the barn once. And a clever hand can make one at the tinker's bench: an oil flask, and dried herbs for a wick.",
                        "voiceClip": {
                          "kind": "Asset",
                          "global": "GlobalObjectId_V1-1-4b759a6e7c9a46ae88cc058276c30f2c-8300000-0",
                          "assetGuid": "4b759a6e7c9a46ae88cc058276c30f2c",
                          "path": "Assets/Hollowmere/Media/Voices/Maren_lantern.wav"
                        },
                        "portrait": null,
                        "condition": null,
                        "actions": null,
                        "options": []
                      },
                      {
                        "kind": "Line",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "Then go with care. The marsh keeps what it takes.",
                        "voiceClip": {
                          "kind": "Asset",
                          "global": "GlobalObjectId_V1-1-5ad81d1545019570a90eb9a9f79a24a7-8300000-0",
                          "assetGuid": "5ad81d1545019570a90eb9a9f79a24a7",
                          "path": "Assets/Hollowmere/Media/Voices/Maren_go.wav"
                        },
                        "portrait": null,
                        "condition": null,
                        "actions": null,
                        "options": []
                      },
                      {
                        "kind": "Branch",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "",
                        "voiceClip": null,
                        "portrait": null,
                        "condition": {
                          "kind": "Definition",
                          "authoringId": "28e34721-a716-4890-a863-fb0cfba9df30",
                          "global": "GlobalObjectId_V1-3-850520e0be842c7e9830bf255c4a9069-11400000-0",
                          "assetGuid": "850520e0be842c7e9830bf255c4a9069",
                          "path": "Assets/Hollowmere/Rules/Conditions/ShrineLit.asset"
                        },
                        "actions": null,
                        "options": []
                      },
                      {
                        "kind": "Line",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "The shrine is lit? I felt it tonight, like a held breath let go.",
                        "voiceClip": {
                          "kind": "Asset",
                          "global": "GlobalObjectId_V1-1-71c02f1cbae555acfb8715ddd1724fd1-8300000-0",
                          "assetGuid": "71c02f1cbae555acfb8715ddd1724fd1",
                          "path": "Assets/Hollowmere/Media/Voices/Maren_lit.wav"
                        },
                        "portrait": null,
                        "condition": null,
                        "actions": null,
                        "options": []
                      },
                      {
                        "kind": "Line",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "Find a lantern, then the causeway. The bell is waiting.",
                        "voiceClip": {
                          "kind": "Asset",
                          "global": "GlobalObjectId_V1-1-c4dd9252bc65f65b89bfcdff4e9e5d26-8300000-0",
                          "assetGuid": "c4dd9252bc65f65b89bfcdff4e9e5d26",
                          "path": "Assets/Hollowmere/Media/Voices/Maren_again.wav"
                        },
                        "portrait": null,
                        "condition": null,
                        "actions": null,
                        "options": []
                      },
                      {
                        "kind": "Line",
                        "speaker": "",
                        "speakerEntityId": "",
                        "text": "The bell rang. Hollowmere can sleep again. Thank you, traveller.",
                        "voiceClip": {
                          "kind": "Asset",
                          "global": "GlobalObjectId_V1-1-4be95551503f3a5359dbbdc4121c51f7-8300000-0",
                          "assetGuid": "4be95551503f3a5359dbbdc4121c51f7",
                          "path": "Assets/Hollowmere/Media/Voices/Maren_rung.wav"
                        },
                        "portrait": null,
                        "condition": null,
                        "actions": null,
                        "options": []
                      }
