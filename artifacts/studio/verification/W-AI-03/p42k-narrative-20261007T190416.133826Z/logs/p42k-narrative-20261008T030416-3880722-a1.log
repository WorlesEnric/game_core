nded it. I owe you a crossing.", "voiceClip": {"kind": "Asset", "global": "GlobalObjectId_V1-1-b4ca9038e0c69834695bc1d46b2921b2-8300000-0", "assetGuid": "b4ca9038e0c69834695bc1d46b2921b2", "path": "Assets/Hollowmere/Media/Voices/Odd_thanks.wav"}, "portrait": null, "condition": null, "actions": null, "options": []}, {"kind": "Action", "speaker": "", "speakerEntityId": "", "text": "", "voiceClip": null, "portrait": null, "condition": null, "actions": {"kind": "Definition", "authoringId": "d2a1a116-34a6-4f16-bd03-7575628b11d9", "global": "GlobalObjectId_V1-3-e952c26493555ce73964aef5c959145a-11400000-0", "assetGuid": "e952c26493555ce73964aef5c959145a", "path": "Assets/Hollowmere/Rules/Actions/OddGrantsFavour.asset"}, "options": []}, {"kind": "Choice", "speaker": "", "speakerEntityId": "", "text": "The black water is calm tonight.", "voiceClip": null, "portrait": null, "condition": null, "actions": null, "options": [{"text": "Take me to the belfry.", "condition": {"kind": "Definition", "authoringId": "78eeeedd-9917-460a-8d0e-71d128dc7246", "global": "GlobalObjectId_V1-3-abc1982dda435320caeb533fec290a89-11400000-0", "assetGuid": "abc1982dda435320caeb533fec290a89", "path": "Assets/Hollowmere/Rules/Conditions/HasLantern.asset"}, "hideWhenUnavailable": false}, {"text": "Not yet.", "condition": null, "hideWhenUnavailable": false}]}, {"kind": "Action", "speaker": "", "speakerEntityId": "", "text": "", "voiceClip": null, "portrait": null, "condition": null, "actions": {"kind": "Definition", "authoringId": "421c017e-2867-4d58-821a-67045e416c1b", "global": "GlobalObjectId_V1-3-a352f18a1dcae618b83742479b4bbcc5-11400000-0", "assetGuid": "a352f18a1dcae618b83742479b4bbcc5", "path": "Assets/Hollowmere/Rules/Actions/FerryCrossing.asset"}, "options": []}, {"kind": "Line", "speaker": "", "speakerEntityId": "", "text": "I will be here. The water is patient.", "voiceClip": {"kind": "Asset", "global": "GlobalObjectId_V1-1-7650ef440c5863f3f8658e8e77831ae2-8300000-0", "assetGuid": "7650ef440c