{"policy":"AllOrNothing","state":"Applied","ok":true,"rolledBack":false,"milliseconds":56.6,"outcomes":[{"opId":"op1","status":"Applied","undo":{"inverse":{"operations":[{"opId":"inverse","tool":"set","target":{"kind":"Definition","authoringId":"aa779457-076d-496c-84b5-72019a826681","global":"GlobalObjectId_V1-3-b2bacaee2c3034819a57dae4f343b3ee-11400000-0","assetGuid":"b2bacaee2c3034819a57dae4f343b3ee","path":"Assets/Hollowmere/Dialogue/Graphs/Odd.asset"},"args":{"fields":{"nodes":[{"kind":"Branch","speaker":"","speakerEntityId":"","text":"","voiceClip":null,"portrait":null,"condition":{"kind":"Definition","authoringId":"a6f7c2a5-47b1-4fe9-a6fb-a5946f443f67","global":"GlobalObjectId_V1-3-5dc4b5ce6affc78bc94dd2031bc52e2d-11400000-0","assetGuid":"5dc4b5ce6affc78bc94dd2031bc52e2d","path":"Assets/Hollowmere/Rules/Conditions/OddFavour.asset"},"actions":null,"options":[]},{"kind":"Branch","speaker":"","speakerEntityId":"","text":"","voiceClip":null,"portrait":null,"condition":{"kind":"Definition","authoringId":"28e34721-a716-4890-a863-fb0cfba9df30","global":"GlobalObjectId_V1-3-850520e0be842c7e9830bf255c4a9069-11400000-0","assetGuid":"850520e0be842c7e9830bf255c4a9069","path":"Assets/Hollowmere/Rules/Conditions/ShrineLit.asset"},"actions":null,"options":[]},{"kind":"Line","speaker":"","speakerEntityId":"","text":"The belfry? I ferry no strangers over that water. Light the sunken shrine, west to east, and we will talk. Or patch the old punt yourself; it wants pitch from an oil flask.","voiceClip":{"kind":"Asset","global":"GlobalObjectId_V1-1-5fdc82ba185d091d09bf83838a024617-8300000-0","assetGuid":"5fdc82ba185d091d09bf83838a024617","path":"Assets/Hollowmere/Media/Voices/Odd_refuse.wav"},"portrait":null,"condition":null,"actions":null,"options":[]},{"kind":"Line","speaker":"","speakerEntityId":"","text":"You lit the old shrine. My mother tended it. I owe you a crossing.","voiceClip":{"kind":"Asset","global":"GlobalObjectId_V1-1-b4ca9038e0c69834695bc1d46b2921b2-8300000-0","ass