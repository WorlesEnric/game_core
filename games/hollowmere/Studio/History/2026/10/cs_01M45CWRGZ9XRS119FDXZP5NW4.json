                      },
                      "options": []
                    },
                    {
                      "kind": "Line",
                      "speaker": "",
                      "speakerEntityId": "",
                      "text": "Bless you. Odd keeps the marsh gate key, and he will want coin for it.",
                      "voiceClip": null,
                      "portrait": null,
                      "condition": null,
                      "actions": null,
                      "options": []
                    },
                    {
                      "kind": "Line",
                      "speaker": "",
                      "speakerEntityId": "",
                      "text": "Because the marsh will not let anyone rest until that bell rings again.",
                      "voiceClip": null,
                      "portrait": null,
                      "condition": null,
                      "actions": null,
                      "options": []
                    },
                    {
                      "kind": "Line",
                      "speaker": "",
                      "speakerEntityId": "",
                      "text": "You rang it! Hollowmere can sleep again. Take my lantern, you have earned it.",
                      "voiceClip": null,
                      "portrait": null,
                      "condition": null,
                      "actions": null,
                      "options": []
                    }
