                      },
                      "options": []
                    },
                    {
                      "kind": "Choice",
                      "speaker": "",
                      "speakerEntityId": "",
                      "text": "Will you help us?",
                      "voiceClip": null,
                      "portrait": null,
                      "condition": null,
                      "actions": null,
                      "options": [
                        {
                          "text": "I'll find the clapper and ring it.",
                          "condition": null,
                          "hideWhenUnavailable": false
                        },
                        {
                          "text": "Why should I help?",
                          "condition": null,
                          "hideWhenUnavailable": false
                        }
                      ]
                    },
                    {
