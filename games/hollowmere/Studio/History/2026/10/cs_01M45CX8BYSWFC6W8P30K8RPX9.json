          "entry": 0,
          "nodes": [
            {
              "kind": "Branch",
              "speaker": "",
              "speakerEntityId": "",
              "text": "",
              "voiceClip": null,
              "portrait": null,
              "condition": "Assets/Hollowmere/Rules/Conditions/BellRung.asset",
              "actions": null,
              "options": []
            },
            {
              "kind": "Branch",
              "speaker": "",
              "speakerEntityId": "",
              "text": "",
              "voiceClip": null,
              "portrait": null,
              "condition": "Assets/Hollowmere/Rules/Conditions/HeardRumour.asset",
              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "Traveller, you look half drowned yourself. Sit a moment. I am Maren, the healer here.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Maren_greet.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "Since the flood the bell in the old belfry has been silent, and the marsh has gone dark and hungry.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Maren_rumour.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
            {
              "kind": "Action",
              "speaker": "",
              "speakerEntityId": "",
              "text": "",
              "voiceClip": null,
              "portrait": null,
              "condition": null,
              "actions": "Assets/Hollowmere/Rules/Actions/MarenIntro.asset",
              "options": []
            },
            {
              "kind": "Choice",
              "speaker": "",
              "speakerEntityId": "",
              "text": "Will you go to the belfry?",
              "voiceClip": null,
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": [
                {
                  "text": "How do I cross the marsh?",
                  "condition": null,
                  "hideWhenUnavailable": false
                },
                {
                  "text": "Where would I find a lantern?",
                  "condition": null,
                  "hideWhenUnavailable": false
                },
                {
                  "text": "I will go.",
                  "condition": null,
                  "hideWhenUnavailable": false
                }
              ]
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "Warden Hale keeps the causeway gate and lets no one into Blackmere without a light. Past it, Odd's ferry, or the old punt by the jetty.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Maren_cross.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "Bram sells them at the inn. There was one in the barn once. And a clever hand can make one at the tinker's bench: an oil flask, and dried herbs for a wick.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Maren_lantern.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "Then go with care. The marsh keeps what it takes.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Maren_go.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
            {
              "kind": "Branch",
              "speaker": "",
              "speakerEntityId": "",
              "text": "",
              "voiceClip": null,
              "portrait": null,
              "condition": "Assets/Hollowmere/Rules/Conditions/ShrineLit.asset",
              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "The shrine is lit? I felt it tonight, like a held breath let go.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Maren_lit.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "Find a lantern, then the causeway. The bell is waiting.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Maren_again.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "The bell rang. Hollowmere can sleep again. Thank you, traveller.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Maren_rung.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            }
          ],
