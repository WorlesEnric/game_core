            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "Halt. Blackmere eats folk who walk it dark. Come back with a lantern and I will open the gate.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Hale_halt.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "A lantern, and lit. Fair enough. Mind the sinkholes: anything that glints out there is bait.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Hale_pass.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
