              "voiceClip": null,
              "portrait": null,
              "condition": "Assets/Hollowmere/Rules/Conditions/ShrineLit.asset",
              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "The shrine burns again. First night in years I have not felt watched out here.",
              "voiceClip": "Assets/Hollowmere/Media/Voices/Hale_lit.wav",
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "The gate is open. Odd ferries from the jetty, if he likes you.",
