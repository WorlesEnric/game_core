            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "The belfry? I ferry no strangers over that water. Light the sunken shrine, west to east, and we will talk. Or patch the old punt yourself; it wants pitch from an oil flask.",
              "voiceClip": null,
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
            {
              "kind": "Line",
              "speaker": "",
              "speakerEntityId": "",
              "text": "You lit the old shrine. My mother tended it. I owe you a crossing.",
              "voiceClip": null,
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": []
            },
            {
