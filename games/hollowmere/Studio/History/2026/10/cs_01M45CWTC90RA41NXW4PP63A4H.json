            {
              "kind": "Choice",
              "speaker": "",
              "speakerEntityId": "",
              "text": "The black water is calm tonight.",
              "voiceClip": null,
              "portrait": null,
              "condition": null,
              "actions": null,
              "options": [
                {
                  "text": "Take me to the belfry.",
                  "condition": "Assets/Hollowmere/Rules/Conditions/HasLantern.asset",
                  "hideWhenUnavailable": false
                },
                {
                  "text": "Not yet.",
                  "condition": null,
