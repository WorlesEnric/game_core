  - id: ui.deleted
    text: Save deleted.
  - id: ui.no-save
    text: There is no saved game yet.
  - id: ui.save-unavailable
    text: Saving is not available in this build (GP-UI-014).
  - id: save.missing-slot
    text: 'save.missing-slot: there is no save in this slot; choose another slot'
  - id: save.corrupt-file
    text: 'save.corrupt-file: the save file is damaged and cannot be loaded; delete
      it or load another slot'
  - id: save.catalog-mismatch
    text: 'save.catalog-mismatch: the save belongs to another content version of
      the game and this build declares no migration from it'
  - id: save.migration-path-missing
    text: 'save.migration-path-missing: the save needs a data migration this build
      does not include'
  - id: save.unsafe-state
    text: 'save.unsafe-state: the game is busy; try again at the next pause'
  - id: save.invalid-slot
    text: 'save.invalid-slot: slot names are 1-64 characters of a-z, 0-9, ''-'' and
      ''_'', starting with a letter or digit; received ''null'''
  - id: save.capture-failed
    text: 'save.capture-failed: the game could not be captured at a safe point; try
      again'
  - id: save.storage-failed
    text: 'save.storage-failed: the save could not be written to disk; check free
      space and permissions'
  - id: save.restore-refused
    text: 'save.restore-refused: the save could not be rebuilt into a running world'
  - id: save.newer-build
    text: 'save.newer-build: the save was written by a newer build of the game; load
      it with that build'
