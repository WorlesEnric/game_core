    text: 
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options:
    - text: Where is the clapper?
      condition: {fileID: 0}
      hideWhenUnavailable: 0
    - text: Anything about the shrine?
      condition: {fileID: 0}
      hideWhenUnavailable: 0
    - text: Bye, Pip.
      condition: {fileID: 0}
      hideWhenUnavailable: 0
  - kind: 3
