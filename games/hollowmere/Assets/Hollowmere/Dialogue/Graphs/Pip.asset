  nodes:
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: Did you ever hear the bell? Gran says it rang every dusk before the flood.
    voiceClip: {fileID: 8300000, guid: 98bd640ca1f0638a7b10ccce20ebb545, type: 3}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
