    options: []
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: It fell in the marsh, by the dead willow. Hale will not let me look.
    voiceClip: {fileID: 8300000, guid: 1136afa3f650dff97b0fec8264e15cab, type: 3}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options: []
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: 'Gran says you light the shrine lanterns the way the sun walks: from the
      willow in the west to the water in the east.'
    voiceClip: {fileID: 8300000, guid: c586f9e22dd50c9d4b9da9eabf02235d, type: 3}
