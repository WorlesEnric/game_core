  - kind: 1
    speaker: 
    speakerEntityId: 
    text: What will it be?
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options:
    - text: A lantern (4 coins)
      condition: {fileID: 11400000, guid: 312f20932391eaf6ea780ae71f56382c, type: 2}
      hideWhenUnavailable: 0
    - text: An oil flask (2 coins)
      condition: {fileID: 11400000, guid: 9a2aea3c3bfe56c71be5f263b0e6302e, type: 2}
