    - text: Marsh herbs (1 coin)
      condition: {fileID: 11400000, guid: f10a72a8291c2c2be95c2e076e33a456, type: 2}
      hideWhenUnavailable: 0
    - text: Nothing, thanks.
      condition: {fileID: 0}
      hideWhenUnavailable: 0
  - kind: 0
    speaker: 
    speakerEntityId: 
