  nodes:
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: Welcome to the Drowned Lantern. Coin for goods, and no questions.
    voiceClip: {fileID: 8300000, guid: 86608ff42b86350c6a2afddfa71219de, type: 3}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
