    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 11400000, guid: 1b459c779c5c6191b9a13e56b29434c6, type: 2}
    options: []
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: For Maren, then. Take it, and do not drown.
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
