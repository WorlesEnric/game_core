  nodes:
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: The gate key? Three old coins, and no haggling.
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options: []
  - kind: 1
    speaker: 
    speakerEntityId: 
    text: 
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options:
    - text: Here are three coins.
      condition: {fileID: 11400000, guid: c1de2c141423889659daf3556d78f3a3, type: 2}
      hideWhenUnavailable: 0
    - text: Maren sent me. She trusts me.
      condition: {fileID: 11400000, guid: 20525d4762e7ea943baf62305ce6e41c, type: 2}
      hideWhenUnavailable: 1
    - text: Not now.
      condition: {fileID: 0}
      hideWhenUnavailable: 0
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: Pleasure doing business. Mind the reeds.
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options: []
  - kind: 3
    speaker: 
    speakerEntityId: 
    text: 
