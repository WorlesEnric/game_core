    actions: {fileID: 0}
    options: []
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: The belfry? I ferry no strangers over that water. Light the sunken shrine,
      west to east, and we will talk. Or patch the old punt yourself; it wants pitch
      from an oil flask.
    voiceClip: {fileID: 8300000, guid: 5fdc82ba185d091d09bf83838a024617, type: 3}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options: []
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: You lit the old shrine. My mother tended it. I owe you a crossing.
    voiceClip: {fileID: 8300000, guid: b4ca9038e0c69834695bc1d46b2921b2, type: 3}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options: []
  - kind: 3
    speaker: 
    speakerEntityId: 
    text: 
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 11400000, guid: e952c26493555ce73964aef5c959145a, type: 2}
    options: []
  - kind: 1
    speaker: 
    speakerEntityId: 
    text: The black water is calm tonight.
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options:
    - text: Take me to the belfry.
      condition: {fileID: 11400000, guid: abc1982dda435320caeb533fec290a89, type: 2}
      hideWhenUnavailable: 0
    - text: Not yet.
      condition: {fileID: 0}
      hideWhenUnavailable: 0
  - kind: 3
    speaker: 
    speakerEntityId: 
    text: 
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 11400000, guid: a352f18a1dcae618b83742479b4bbcc5, type: 2}
    options: []
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: I will be here. The water is patient.
    voiceClip: {fileID: 8300000, guid: 7650ef440c5863f3f8658e8e77831ae2, type: 3}
    portrait: {fileID: 0}
    condition: {fileID: 0}
