  nodes:
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: The gate key? Three old coins, and no haggling.
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options: []
  - kind: 1
    speaker: 
    speakerEntityId: 
    text: 
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options:
    - text: Here are three coins.
      condition: {fileID: 11400000, guid: 15cab9d4851d1b20a9c603203c748fc4, type: 2}
      hideWhenUnavailable: 0
    - text: Maren sent me. She trusts me.
      condition: {fileID: 11400000, guid: f844f31f91c68c8f1a597004bb15e78a, type: 2}
      hideWhenUnavailable: 1
    - text: Not now.
      condition: {fileID: 0}
      hideWhenUnavailable: 0
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: Pleasure doing business. Mind the reeds.
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options: []
  - kind: 3
    speaker: 
    speakerEntityId: 
