    options: []
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: For Maren, then. Take it, and do not drown.
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
