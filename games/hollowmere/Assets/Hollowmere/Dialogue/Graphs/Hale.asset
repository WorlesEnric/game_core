    actions: {fileID: 0}
    options: []
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: Halt. Blackmere eats folk who walk it dark. Come back with a lantern and
      I will open the gate.
    voiceClip: {fileID: 8300000, guid: d7588b358ad8ad43091865a2b5dc1783, type: 3}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options: []
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: 'A lantern, and lit. Fair enough. Mind the sinkholes: anything that glints
      out there is bait.'
    voiceClip: {fileID: 8300000, guid: d63e6842bc488ef4695dd0209879f652, type: 3}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options: []
  - kind: 3
    speaker: 
    speakerEntityId: 
    text: 
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 11400000, guid: de277e8d1a615d2ff8aa2c0da24b5907, type: 2}
    options: []
  - kind: 2
    speaker: 
    speakerEntityId: 
    text: 
    voiceClip: {fileID: 0}
    portrait: {fileID: 0}
    condition: {fileID: 11400000, guid: 850520e0be842c7e9830bf255c4a9069, type: 2}
    actions: {fileID: 0}
    options: []
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: The shrine burns again. First night in years I have not felt watched out
      here.
    voiceClip: {fileID: 8300000, guid: 88f6bf82ac23311a5abb7f6a5aa177cf, type: 3}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
    options: []
  - kind: 0
    speaker: 
    speakerEntityId: 
    text: The gate is open. Odd ferries from the jetty, if he likes you.
    voiceClip: {fileID: 8300000, guid: 655bc2c22a34d85268956a5a074fc5f4, type: 3}
    portrait: {fileID: 0}
    condition: {fileID: 0}
    actions: {fileID: 0}
