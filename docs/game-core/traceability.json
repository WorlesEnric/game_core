  "waves": [
    {
      "id": 0,
      "entry": "Only this documentation set and a licensed/installed candidate toolchain are required. No runtime prerequisite is assumed.",
      "exit": "GC-001 player probe runs successfully with an exact lock; GC-002 pure fixtures, compiled shared reference seams/API snapshots and documentation checker run. Baseline or public-seam failures change the explicit decision before dependent modules begin."
    },
    {
      "id": 1,
      "entry": "W0 gate passes; ID/version and build assumptions are explicit.",
      "exit": "Integrate catalog/DTOs, control host and actual Unity world driver. Create two worlds, admit one operation and execute a guarded fixture stage; prove a thrown postwrite exception stops the next stage and publication."
    },
    {
      "id": 2,
      "entry": "W1 shared contracts, generated keys, control admission and world dispatch are integrated.",
      "exit": "Use all real W2 outputs together: mount a provider, derive a compatible target, publish its real Entities layout and compiled schedule, execute one bounded command, observe one consistent result, spawn a future target, and run the player smoke path. Independent seam fixtures do not substitute for this integration."
    },
    {
      "id": 3,
      "entry": "W2 end-to-end automatic assembly gate passes.",
      "exit": "Run narrative and cards with the same kernel. Show zero idle command steps, automatic existing/future targets, a narrative state change and a card domain transfer. Both Unity-world fixtures must pass before provisional generic execution review."
    },
    {
      "id": 4,
      "entry": "W3 proves narrative and card slices; all public seams remain subject to correction.",
      "exit": "Run both families in IL2CPP, then integrate indexed move/mode changes, service-closure lifecycle and slot policies. Demonstrate both mode directions, a subtree move preserving state, suspend/resume and provider loss/unload. Provisional generic execution freeze requires GC-012; dynamic composition is still awaiting later stress/fault completion."
    },
    {
      "id": 5,
      "entry": "W4 live transitions and early player gate pass.",
      "exit": "Join retained observation, deterministic faults, checkpoint restore and common adapters in one actual world. Show prewrite rejection, postwrite fail-stop, new-session restore, read-only snapshots and stale asset callback rejection."
    },
    {
      "id": 6,
      "entry": "W5 recovery/adapter boundary is integrated and safe.",
      "exit": "Integrate the fixed-step action reference, durable reward delivery, unload stress and replay/cost counters. Demonstrate that optional physics/animation are absent from cards/narrative. Complete 1,000-cycle teardown and repeatability fixtures before broader qualification."
    },
    {
      "id": 7,
      "entry": "W6 mechanisms are integrated on one revision; no known unsafe lifetime defect remains.",
      "exit": "All reference transition tables and cross-template flow pass; complete IL2CPP/headless catalog coverage runs; faulted checkpoint/outbox recovery passes; benchmark data and budget decisions are recorded. Production fixes require affected gates rerun on the new revision."
    },
    {
      "id": 8,
      "entry": "W7 gates pass on a recorded source/catalog/lock revision.",
      "exit": "Every P requirement and O operation has passing executable evidence; clean-checkout build/run and documentation commands reproduce the declared profile. No NotRun or Blocked required case is waived."
    },
    {
      "id": 9,
      "entry": "GC-028 and GC-029 pass against the same accepted revision.",
      "exit": "GC-030 records V1-complete status with exact supported profile and current evidence. Otherwise the status remains incomplete; no automatic external distribution occurs."
    }
  ]
}
