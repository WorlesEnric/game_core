{
  "$defs": {
    "AuthorScope": {
      "enum": [
        "Instance",
        "Prefab",
        "Definition",
        "Scope"
      ],
      "type": "string"
    },
    "AuthoringKind": {
      "enum": [
        "Entity",
        "Definition",
        "Region",
        "SceneObject",
        "Asset",
        "UiElement",
        "Scope",
        "Location"
      ],
      "type": "string"
    },
    "AuthoringRef": {
      "additionalProperties": false,
      "properties": {
        "assetGuid": {
          "minLength": 1,
          "type": "string"
        },
        "authoringId": {
          "minLength": 1,
          "type": "string"
        },
        "definition": {
          "pattern": "^[a-z0-9][a-z0-9._-]*@[0-9A-Za-z]+$",
          "type": "string"
        },
        "global": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AuthoringKind"
        },
        "location": {
          "$ref": "#/$defs/LocationRef"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AuthorScope"
        },
        "stamp": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "CameraPose": {
      "additionalProperties": false,
      "properties": {
        "aspect": {
          "type": "number"
        },
        "fov": {
          "type": "number"
        },
        "position": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "rotation": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "aspect",
        "fov",
        "position",
        "rotation"
      ],
      "type": "object"
    },
    "FrameContext": {
      "additionalProperties": false,
      "properties": {
        "camera": {
          "$ref": "#/$defs/CameraPose"
        },
        "image": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "viewport": {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "camera",
        "viewport"
      ],
      "type": "object"
    },
    "LocationRef": {
      "additionalProperties": false,
      "properties": {
        "normal": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "position": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "region": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "position",
        "region"
      ],
      "type": "object"
    },
    "PartRef": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "$ref": "#/$defs/AuthoringRef"
        },
        "part": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "owner",
        "part"
      ],
      "type": "object"
    },
    "RegionRect": {
      "additionalProperties": false,
      "properties": {
        "screen": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "screen"
      ],
      "type": "object"
    },
    "SelectionMode": {
      "enum": [
        "Edit",
        "Play"
      ],
      "type": "string"
    }
  },
  "$id": "urn:gamecore:studio:schema:selection-snapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "frame": {
      "$ref": "#/$defs/FrameContext"
    },
    "id": {
      "pattern": "^sel_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "indexRevision": {
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/SelectionMode"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/PartRef"
      },
      "type": "array"
    },
    "regionRect": {
      "$ref": "#/$defs/RegionRect"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/AuthoringRef"
      },
      "type": "array"
    },
    "worldSession": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "indexRevision",
    "mode",
    "targets"
  ],
  "title": "SelectionSnapshot",
  "type": "object"
}
