<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generated by studio/stage/make-slot.py: NUnit tests of the staged rules half under plain dotnet. Package versions
       are the repository's (dotnet/tests/*.csproj), so the host's NuGet cache already holds them. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>@@ASSEMBLY@@.Tests</AssemblyName>
    <RootNamespace>@@ASSEMBLY@@.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="@@TESTS_DIR@@/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Rules/Rules.csproj" />
  </ItemGroup>

</Project>
