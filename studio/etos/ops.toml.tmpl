# GameCore Studio operation providers (docs/studio/04-etos-integration.md §5). Rendered into
# <root>/ops.toml by studio/etos/install.sh (no substitutions). Keys are credential references
# resolved by etosd from its environment; none is written here.
#
# Published TTS list price checked 2026-10-06. Companion caps fail closed without a
# declared tariff. # @studio annotations are parsed by install-state.py, never sent
# to providers. Echo requires an operator-declared total estimate before full apply.

# Voice input: transcript-only realtime sessions (the companion never sends response_create).
[[realtime]]
name = "studio-voice"
kind = "bailian-omni"
model = "qwen3-omni-flash-realtime"
credential = "env:BAILIAN_API_KEY"
turn_detection = "semantic_vad"
vad_threshold = 0.5

# Image generation: Echo, OpenAI-compatible /images/generations. Both options were accepted by
# the provider on 2026-10-04 (artifacts/studio/environment/provider-probe-2026-10-04.md).
[[providers]]
name = "echo-images"
family = "image"
kind = "openai-images"
base_url = "https://api.echo-coding.com/v1"
credential = "env:ECHO_API_KEY"
model = "gpt-image-2"
options = { quality = "low", response_format = "b64_json" }
[providers.limits]
timeout = "300s"
max_outputs = 4
# No published Echo reseller list price is verified. This is NOT an OpenAI list price.
# Owner declared a total estimate on 2026-10-06; this is not a reseller invoice.
# @studio source = "operator"
# @studio note = "Owner-declared total per-image estimate (2026-10-06), basis: OpenAI gpt-image published list prices; Echo publishes no tariff"
# @studio unit = "image"
[providers.cost]
per_unit = 0.20

# Image description: a vision chat model of models.toml.
[[providers]]
name = "echo-describe"
family = "describe"
kind = "chat"
model = "echo/gpt-5.6-sol"
# No published Echo reseller describe tariff could be verified (2026-10-06).
# Provider site checked: https://api.echo-coding.com (no public tariff returned).
# Publisher token prices do not bind this reseller's total charge. Full template apply
# refuses tariff_placeholder until the operator sets BOTH a positive total per-call
# estimate and its basis below. Never interpret this placeholder as a free operation.
# @studio source = "operator"
# @studio note = "SET_BY_OPERATOR: total USD estimate per describe call"
# @studio unit = "call"
[providers.cost]
per_unit = 0.0 # SET_BY_OPERATOR

# Text to speech: DashScope native multimodal-generation (etos kind `bailian-tts`, SADR-005).
[[providers]]
name = "bailian-tts"
family = "tts"
kind = "bailian-tts"
base_url = "https://dashscope.aliyuncs.com/api/v1"
credential = "env:BAILIAN_API_KEY"
model = "qwen3-tts-flash"
options = { voice = "Cherry", language_type = "English" }
[providers.limits]
timeout = "120s"
# @studio source = "published"
# @studio url = "https://www.alibabacloud.com/help/en/model-studio/model-pricing"
# @studio unit = "bailian_character"
# Source: https://www.alibabacloud.com/help/en/model-studio/model-pricing
# Qwen3-TTS-Flash, Chinese mainland: $0.114682 / 10,000 input characters.
[providers.cost]
per_unit = 0.0000114682

# 3D generation (family "3d", kind "predictions") is deliberately absent: no provider
# credential exists on this host (SADR-020). `POST /ops/generate.3d` therefore answers
# `not_configured`, which Studio shows as blocked. To enable it, an operator adds e.g.:
#
# [[providers]]
# family = "3d"
# kind = "predictions"
# base_url = "https://api.replicate.com/v1"
# credential = "env:REPLICATE_API_TOKEN"
# model = "<owner>/<model>"
# input = { prompt = "{{prompt}}", image = "{{reference}}" }
