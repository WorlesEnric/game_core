# GameCore Studio model catalog (docs/studio/04-etos-integration.md §8). Rendered into
# <root>/models.toml by studio/etos/install.sh (no substitutions). The key is resolved by
# etosd from its environment on every call and is never written here.
#
# List prices checked 2026-10-05 from the model publishers. Echo's reseller tariff is
# not publicly verifiable; the integrator must reconcile any markup before deployment.
# No zero-price model entries. Rates below are USD / million tokens at standard context.

[endpoints.echo]
base_url = "https://api.echo-coding.com/v1"
credential = "env:ECHO_API_KEY"

[endpoints.echo.limits]
requests_per_minute = 120
max_concurrency = 8
timeout = "300s"

# The Studio workers' model (gc-designer, gc-mechanic).
[[models]]
id = "echo/claude-opus-5-5"
aliases = ["default"]
roles = ["worker", "planning", "controller", "compaction"]
cost_class = "high"
# Source (all three rates): https://platform.claude.com/docs/en/models/opus-5-5/whats-new-opus-5-5
[models.sla.cost]
input = 4.0
cached_input = 0.2
output = 20.0
[models.capabilities]
context_window = 200000
max_output = 32000
tools = true
parallel_tools = true
vision = true

# A faster model for short planning and compaction.
[[models]]
id = "echo/gpt-6-sol"
aliases = ["fast"]
roles = ["worker", "planning", "controller", "compaction"]
cost_class = "high"
# Source (all three rates): https://developers.openai.com/api/docs/models/gpt-6-sol
[models.sla.cost]
input = 2.0
cached_input = 0.2
output = 10.0
[models.capabilities]
context_window = 400000
max_output = 128000
tools = true
parallel_tools = true
structured_output = true
vision = true

# The `describe` operation's vision model (ops.toml, kind "chat").
[[models]]
id = "echo/gpt-5.6-sol"
aliases = ["describe"]
roles = ["controller"]
cost_class = "high"
# Source (all three rates): https://developers.openai.com/api/docs/models/gpt-5.6-sol
[models.sla.cost]
input = 4.0
cached_input = 0.4
output = 20.0
[models.capabilities]
context_window = 400000
max_output = 128000
tools = true
structured_output = true
vision = true
