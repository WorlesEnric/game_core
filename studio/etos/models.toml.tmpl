# GameCore Studio model catalog (docs/studio/04-etos-integration.md §8). Rendered into
# <root>/models.toml by studio/etos/install.sh (no substitutions). The key is resolved by
# etosd from its environment on every call and is never written here.
#
# Prices are deliberately not configured: no provider price list was verified for this host,
# so usage is reported in tokens and the catalog's cost is 0 (budgets in USD do not bind chat
# models until an operator adds [models.sla] cost entries).

[endpoints.echo]
base_url = "https://api.echo-coding.com/v1"
credential = "env:ECHO_API_KEY"

[endpoints.echo.limits]
requests_per_minute = 120
max_concurrency = 8
timeout = "300s"

# The Studio workers' model (gc-designer, gc-mechanic).
[[models]]
id = "echo/claude-opus-5-5"
aliases = ["default"]
roles = ["worker", "planning", "controller", "compaction"]
cost_class = "high"
[models.capabilities]
context_window = 200000
max_output = 32000
tools = true
parallel_tools = true
vision = true

# A faster model for short planning and compaction.
[[models]]
id = "echo/gpt-6-sol"
aliases = ["fast"]
roles = ["worker", "planning", "controller", "compaction"]
cost_class = "high"
[models.capabilities]
context_window = 400000
max_output = 128000
tools = true
parallel_tools = true
structured_output = true
vision = true

# The `describe` operation's vision model (ops.toml, kind "chat").
[[models]]
id = "echo/gpt-5.6-sol"
aliases = ["describe"]
roles = ["controller"]
cost_class = "high"
[models.capabilities]
context_window = 400000
max_output = 128000
tools = true
structured_output = true
vision = true
