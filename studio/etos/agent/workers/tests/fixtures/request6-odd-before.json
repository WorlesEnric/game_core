    {
      "kind": 0,
      "speaker": null,
      "speakerEntityId": null,
      "text": "The belfry? I ferry no strangers over that water. Light the sunken shrine, west to east, and we will talk. Or patch the old punt yourself; it wants pitch from an oil flask.",
      "voiceClip": {
        "fileID": 8300000,
        "guid": "5fdc82ba185d091d09bf83838a024617",
        "type": 3
      },
      "portrait": {
        "fileID": 0
